<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Bedtime</AssemblyName>
    <RootNamespace>Bedtime</RootNamespace>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- Unity supplies the game's transitive runtime dependencies. -->
    <Reference Include="$(ManagedDir)/assembly_valheim.dll" Private="false" ExternallyResolved="true" />
    <Reference Include="$(ManagedDir)/UnityEngine*.dll" Private="false" />
    <Reference Include="$(BepInExDir)/core/BepInEx.dll" Private="false" />
    <Reference Include="$(BepInExDir)/core/0Harmony.dll" Private="false" />
  </ItemGroup>
  <Target Name="ValidateGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ManagedDir)/assembly_valheim.dll')" Text="Valheim assemblies were not found in $(ManagedDir). Set GameDir or ManagedDir to your installation." />
    <Error Condition="!Exists('$(BepInExDir)/core/BepInEx.dll')" Text="BepInEx was not found in $(BepInExDir). Set BepInExDir to your mod profile's BepInEx directory." />
  </Target>
  <Import Project="../../build/Package.targets" />
</Project>
